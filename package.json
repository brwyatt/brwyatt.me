{
  "name": "brwyatt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for brwyatt.me website and infrastructure",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
